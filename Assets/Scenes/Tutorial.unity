  gameCamera: {fileID: 519420031}
  levelSelectionScene: "LevelSelection"
  rooms:
  - instruction: "Обойди две стены и пройди в проход сверху. WASD или стрелки — движение."
    center: {x: 20, y: 0}
    size: {x: 18, y: 10}
    gate: {fileID: 0}
    targets: []
  - instruction: "Уничтожь три мишени. Мышь — прицел, ЛКМ — выстрел. Затем выход слева."
    center: {x: 20, y: 12}
    size: {x: 18, y: 10}
    gate: {fileID: 3220}
    targets:
    - {fileID: 2323}
    - {fileID: 2383}
    - {fileID: 2443}
  - instruction: "Уничтожь двух роботов и уклоняйся от их шаров. Попадание в тебя — перезапуск. Выход снизу."
    center: {x: 0, y: 12}
    size: {x: 18, y: 10}
    gate: {fileID: 3240}
    targets:
    - {fileID: 2503}
    - {fileID: 2663}
  - instruction: "Враг за колонной. Попади в него через синее зеркало сверху или снизу. Стены поглощают шары."
    center: {x: 0, y: 0}
    size: {x: 18, y: 10}
    gate: {fileID: 3260}
    targets:
    - {fileID: 2823}
  - instruction: "Красный щит блокирует обычные шары. Шар от красного зеркала снимает щит. Затем добей врага."
    center: {x: -20, y: 0}
    size: {x: 18, y: 10}
    gate: {fileID: 0}
    targets:
    - {fileID: 2983}
