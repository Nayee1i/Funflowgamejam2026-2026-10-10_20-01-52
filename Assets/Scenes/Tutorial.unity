--- !u!114 &1002
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c21c43512ae046908a93782dac38a183, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  player: {fileID: 1021}
  gameCamera: {fileID: 519420031}
  rooms:
  - instruction: "\u041E\u0431\u043E\u0439\u0434\u0438 \u0434\u0432\u0435 \u0441\u0442\u0435\u043D\u044B \u0438 \u043F\u0440\u043E\u0439\u0434\u0438 \u0432 \u043F\u0440\u043E\u0445\u043E\u0434 \u0441\u0432\u0435\u0440\u0445\u0443. WASD \u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u0438 \u2014 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435."
    center: {x: 20, y: 0}
    size: {x: 18, y: 10}
    gate: {fileID: 0}
    targets: []
    checkpoint: {fileID: 519420277}
  - instruction: "Мышь — прицел, ЛКМ — огонь. Уничтожь три мишени: у каждой 1 HP. Затем выход слева."
    center: {x: 20, y: 12}
    size: {x: 18, y: 10}
    gate: {fileID: 3220}
    targets:
    - {fileID: 2323}
    - {fileID: 2383}
    - {fileID: 2443}
    checkpoint: {fileID: 519420297}
  - instruction: "Уничтожь двух роботов (5 HP) и уклоняйся от пуль. Прямое попадание — 1 урон, пуля после зеркала — 5. Попадание в тебя — возврат к чекпоинту. Выход снизу."
    center: {x: 0, y: 12}
    size: {x: 18, y: 10}
    gate: {fileID: 3240}
    targets:
    - {fileID: 2503}
    - {fileID: 2663}
    checkpoint: {fileID: 519420317}
  - instruction: "Враг за колонной. Используй синее зеркало сверху или снизу: рикошет наносит 5 урона. Затем выход слева."
    center: {x: 0, y: 0}
    size: {x: 18, y: 10}
    gate: {fileID: 3260}
    targets:
    - {fileID: 2823}
    checkpoint: {fileID: 519420337}
  - instruction: "\u041A\u0440\u0430\u0441\u043D\u044B\u0439 \u0449\u0438\u0442 \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442 \u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u0448\u0430\u0440\u044B. \u0428\u0430\u0440 \u043E\u0442 \u043A\u0440\u0430\u0441\u043D\u043E\u0433\u043E \u0437\u0435\u0440\u043A\u0430\u043B\u0430 \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u0449\u0438\u0442. \u0417\u0430\u0442\u0435\u043C \u0434\u043E\u0431\u0435\u0439 \u0432\u0440\u0430\u0433\u0430."
    center: {x: -20, y: 0}
    size: {x: 18, y: 10}
    gate: {fileID: 0}
    targets:
    - {fileID: 2983}
    checkpoint: {fileID: 519420357}
  levelSelectionScene: LevelSelection
